# Copie ce fichier en .env et remplis-le.

# Adresse publique de l'appli (celle du tunnel Cloudflare)
PUBLIC_URL=https://prono.example.com

# Jeton du tunnel : Cloudflare Zero Trust > Networks > Tunnels > ton tunnel > Docker
TUNNEL_TOKEN=

# Facultatif : contact pour les services de notification (sinon PUBLIC_URL est utilisée)
VAPID_SUBJECT=
