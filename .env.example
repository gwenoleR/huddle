# Copy this file to .env, next to docker-compose.yml, and fill it in.

# Public HTTPS address of the app (as typed in a phone's browser)
PUBLIC_URL=https://prono.example.com

# Optional: contact for the push notification services (defaults to PUBLIC_URL)
VAPID_SUBJECT=

# Optional instance settings (README, "Settings")
# APP_NAME=Prono NFL entre potes
# APP_SHORT_NAME=Prono
# APP_LANG=fr
# POINTS_REGULAR=1
# POINTS_PLAYOFFS=2
# TZ=Europe/Paris
