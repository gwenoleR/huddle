{
  "name": "huddle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NFL picks among friends: mobile PWA, Node + SQLite server, ESPN data.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --run dev:server & node --run dev:web",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node --run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "pwa-assets-generator",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:snapshot": "tsx scripts/snapshot-db.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.1.0",
    "@fontsource/barlow-condensed": "^5.1.0",
    "@tanstack/query-sync-storage-persister": "^5.106.0",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-query-persist-client": "^5.106.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  }
}
