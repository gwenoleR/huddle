{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["server", "web/src", "tests", "vite.config.ts", "vitest.config.ts", "pwa-assets.config.ts"],
  "exclude": ["web/src/sw.ts"]
}
